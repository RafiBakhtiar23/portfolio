---
import Base from '../layouts/Base.astro';
import ProjectThumb from './ProjectThumb.astro';
import { cv } from '../lib/cv.js';
import { mailHref } from '../lib/mail.js';
import { hasPublic } from '../lib/files.js';
import { fmtMonth, langPrefix } from '../lib/i18n.js';
import { site, copy, ui, skillGroups, education, certifications, projects } from '../data/site.js';

const { lang = 'en' } = Astro.props;
const t = ui[lang];
const c = copy[lang];
const pre = langPrefix(lang);
const total = String(projects.length).padStart(2, '0');
const titleOf = (slug) => projects.find((p) => p.slug === slug)?.title ?? slug;
const eduDates = `${fmtMonth(education.from, lang)} — ${fmtMonth(education.to, lang)}`.toUpperCase();
const pickText = (v) => (typeof v === 'string' ? v : v?.[lang] ?? '');
const levelCount = (lv) => skillGroups.flatMap((g) => g.items).filter((i) => i.level === lv).length;
const certs = certifications.map((x) => ({ ...x, imageOk: Boolean(x.image && hasPublic(x.image)) }));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.fullName,
  jobTitle: site.role,
  url: site.domain,
  address: { '@type': 'PostalAddress', addressLocality: 'Bandung', addressCountry: 'ID' },
  sameAs: [site.github, site.linkedin],
  knowsAbout: ['Go', 'Laravel', 'React', 'PostgreSQL', 'MySQL', 'REST API'],
  alumniOf: { '@type': 'EducationalOrganization', name: education.school },
};
---
<Base title={c.meta.title} description={c.meta.description} home={true} lang={lang} jsonLd={jsonLd}>
  <main id="top">
    <section class="hero section-shell" id="hero" tabindex="-1">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="hero-copy">
        <p class="eyebrow" data-anim="fade"><span class="eyebrow-line"></span> {c.hero.eyebrow}</p>
        <h1 data-lines set:html={c.hero.h1} />
        <p class="hero-intro" data-anim style="--d:450ms">{c.hero.intro}</p>
        <div class="hero-actions" data-anim style="--d:600ms">
          {cv.exists
            ? <a class="button button-gold" href={cv.url} download data-magnetic>{t.downloadCv} <span>↓</span></a>
            : <a class="button button-gold" href="#work" data-magnetic>{t.viewProjects} <span>↘</span></a>}
          {cv.exists && <a class="button button-ghost" href="#work" data-magnetic>{t.viewProjects} <span>↘</span></a>}
          <a class="text-link" href="#contact">{t.contactShort} <span>↗</span></a>
        </div>
      </div>
      <div class="hero-bottom" data-anim="fade" style="--d:900ms"><span>{site.workModes.join(' · ').toUpperCase()}</span><span class="scroll-mark" aria-hidden="true"></span><span>{site.location.toUpperCase()}</span></div>
    </section>

    <section class="snapshot section-shell" aria-label={t.snapshot.label}>
      <dl class="snapshot-grid" data-anim>
        {c.snapshot.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
      <div class="snapshot-links" data-anim>
        {cv.exists && <a href={cv.url} download>{t.snapshot.cv}</a>}
        <a href={site.github} target="_blank" rel="noopener noreferrer">{t.snapshot.github}</a>
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer">{t.snapshot.linkedin}</a>
        <a href={mailHref(lang)}>{t.snapshot.email}</a>
        {site.whatsapp && <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer">{t.snapshot.whatsapp}</a>}
      </div>
    </section>

    <section class="work section-shell" id="work">
      <div class="section-heading"><div><p class="eyebrow" data-anim="fade">{t.work.eyebrow}</p><h2 data-lines set:html={t.work.h2} /></div><span class="work-count" data-anim="fade" set:html={t.work.count(projects.length)} /></div>
      <div class="project-list">
        {projects.map((p, i) => (
          <article class="project-card" data-anim>
            <div class={`project-art ${p.slug}`} data-tilt data-cursor="OPEN">
              <div class="project-art-label">{String(i + 1).padStart(2, '0')} <span>{t.work.caseStudy}</span></div>
              <div class="project-visual"><ProjectThumb slug={p.slug} cover={p.coverFromShot ? (p.screenshots ?? []).find((s) => hasPublic(s.src))?.src : undefined} /></div>
              <div class="project-art-footer"><span>{p.t[lang].type}</span><span>↗</span></div>
            </div>
            <div class="project-info">
              <div class="project-index">{String(i + 1).padStart(2, '0')} / {total}</div>
              <div class="project-description">
                <h3>{p.title}</h3>
                <p>{p.t[lang].summary}</p>
                <p class="project-detail">{p.t[lang].detail}</p>
                <div class="tag-list">{p.tags.map((tag) => <span>{tag}</span>)}</div>
                {(p.demo || p.github) && (
                  <div class="project-links">
                    {p.demo && <a href={p.demo} target="_blank" rel="noopener noreferrer">{t.work.liveDemo}</a>}
                    {p.github && <a href={p.github} target="_blank" rel="noopener noreferrer">{t.work.github}</a>}
                  </div>
                )}
              </div>
              <a class="project-arrow" href={`${pre}/projects/${p.slug}`} aria-label={t.work.read(p.title)} data-magnetic data-cursor="OPEN">↗</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="capabilities section-shell" id="skills">
      <div class="section-kicker" data-anim="fade"><span>02</span><span>{t.skills.kicker}</span></div>
      <div class="capabilities-content">
        <p class="eyebrow" data-anim="fade">{t.skills.eyebrow}</p>
        <h2 data-lines set:html={t.skills.h2} />
        <div class="legend" data-anim="fade">
          <span class="l-project"><i></i>{t.skills.legend.project}<b>{levelCount('project')}</b></span>
          <span class="l-working"><i></i>{t.skills.legend.working}<b>{levelCount('working')}</b></span>
          <span class="l-basic"><i></i>{t.skills.legend.basic}<b>{levelCount('basic')}</b></span>
        </div>
        <div class="tiers">
          {skillGroups.map((g, i) => (
            <div class="tier" data-anim data-spot style={`--d:${i * 80}ms`}>
              <div class="tier-head"><span>{String(i + 1).padStart(2, '0')}</span><h3>{g.name[lang]}</h3><p>{g.note[lang]}</p></div>
              <ul class="chips">
                {g.items.map((it, n) => (
                  <li class={`chip is-${it.level}${it.note ? ' has-note' : ''}`} style={`--n:${n}`}>
                    <b>{it.name}</b>
                    {it.level === 'project' && it.usedIn && <small>{t.skills.usedIn} {it.usedIn.map(titleOf).join(' · ')}</small>}
                    {it.note && <small>{it.note[lang]}</small>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="manifesto about-cinema section-shell" id="about">
      <div class="about-bg">
        <img src="/about-bg.webp" alt={site.fullName} width="1665" height="856" loading="lazy" decoding="async" />
      </div>
      <div class="about-head">
        <div class="section-kicker" data-anim="fade"><span>03</span><span>{t.about.kicker}</span></div>
        <p class="eyebrow" data-anim="fade">{t.about.eyebrow}</p>
      </div>
      <div class="about-body">
        <h2 data-lines set:html={t.about.h2} />
        <div class="manifesto-bottom"><p data-words>{c.about.lead}</p></div>
        <div class="about-more" data-anim>
          {c.about.more.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <section class="education section-shell" id="education">
      <div class="section-kicker" data-anim="fade"><span>04</span><span>{t.education.kicker}</span></div>
      <div class="education-content">
        <p class="eyebrow" data-anim="fade">{t.education.eyebrow}</p>
        <h2 data-lines set:html={t.education.h2} />
        <div class="edu-card" data-anim>
          <div><span class="edu-dates">{eduDates}</span><h3>{education.school}</h3><p>{education.program[lang]}</p></div>
          <div class="edu-score"><b>{education.average}</b><small>{t.education.average}</small></div>
        </div>
        <ol class="cert-list">
          {certs.map((cert, i) => (
            <li class={`cert-row is-${cert.kind}`} data-anim style={`--d:${(i % 2) * 70}ms`}>
              <span class="cert-date">{fmtMonth(cert.date, lang)}</span>
              <div class="cert-main">
                {cert.imageOk && (
                  <a class="cert-thumb" href={cert.image} target="_blank" rel="noopener noreferrer" aria-label={`${t.education.viewCert}: ${cert.title}`}>
                    <img src={cert.image} alt="" width="72" height="52" loading="lazy" decoding="async" />
                  </a>
                )}
                <div>
                  <h3>{cert.title}</h3>
                  <p>{cert.issuer}{cert.detail ? ` · ${pickText(cert.detail)}` : ''}{cert.url && <a class="cert-verify" href={cert.url} target="_blank" rel="noopener noreferrer">{t.education.verify}</a>}</p>
                </div>
              </div>
              <span class="cert-kind">{t.education.kinds[cert.kind]}</span>
            </li>
          ))}
        </ol>
        {site.certsLink && <a class="text-link certs-all" href={site.certsLink} target="_blank" rel="noopener noreferrer" data-anim>{t.education.allCerts}</a>}
      </div>
    </section>

    <section class="contact section-shell" id="contact" data-spot data-spot-target=".status-big">
      <div class="status-big" aria-hidden="true">200 OK<small>RESPONSE · END OF REQUEST</small></div>
      <p class="eyebrow" data-anim="fade"><span class="eyebrow-line"></span> {t.contact.eyebrow}</p>
      <h2 data-lines set:html={t.contact.h2} />
      <div class="contact-bottom" data-anim>
        <p>{c.contact.text}</p>
        <a class="button button-gold" href={mailHref(lang)} data-magnetic>{t.contact.email} <span>↗</span></a>
      </div>
      <div class="contact-email" data-anim>
        <a href={mailHref(lang)}>{site.email}</a>
        <button type="button" class="copy-btn" data-copy={site.email}>{t.contact.copy}</button>
      </div>
      <div class="contact-links" data-anim="fade">
        <a href={site.github} target="_blank" rel="noopener noreferrer">GITHUB ↗</a>
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LINKEDIN ↗</a>
        {site.whatsapp && <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer">{t.contact.whatsapp}</a>}
        {cv.exists && <a href={cv.url} download>{t.contact.cvLink}</a>}
        <a href="#top">{t.contact.top}</a>
      </div>
    </section>
  </main>
</Base>
