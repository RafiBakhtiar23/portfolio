---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Rafi Bakhtiar" description="This page does not exist." lang="en" noindex={true}>
  <main class="section-shell notfound" id="main" tabindex="-1">
    <p class="eyebrow"><span class="eyebrow-line"></span> ERROR 404</p>
    <h1>Page not<br /><em>found.</em></h1>
    <p>The page you are looking for does not exist or has moved.</p>
    <p lang="id">Halaman yang Anda cari tidak ada atau sudah dipindahkan.</p>
    <div class="notfound-actions">
      <a class="button button-gold" href="/">BACK TO HOME <span>↗</span></a>
      <a class="button button-ghost" href="/id/" lang="id">KE BERANDA <span>↗</span></a>
    </div>
  </main>
</Base>
